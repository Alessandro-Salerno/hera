// Studente
entity Studente total exclusive {
    attribute "Codice fiscale" key;
    attribute "Cognome";
    attribute "Genere";
    attribute "Luogo di nascita";
    attribute "Indirizzo";
    attribute "Numero di telefono";

    relation "Rapporto di lavoro passato" (0, N);
    relation Frequenta (0, N);
    relation "Ha frequentato" (0, N);
}

// Specializzazioni studente
entity "Studente dipendente" specifies Studente {
    attribute "Identificatore" key;

    relation "Rapporto lavorativo attivo" (1, 1);
}

entity "Studente autonomo" specifies Studente {
    attribute "Identificatore" key; 
    attribute "Area di interesse"; 
    attribute "Titolo di studi";
}

// Datore di lavoro
entity "Datore di lavoro" total exclusive {
    attribute "Nome" key;
    attribute "Indirizzo sede";

    relation "Rapporto lavorativo attivo" (0, N);
    relation "Rapporto di lavoro passato" (1, N);
}

// Relazioni lavoro
relation "Rapporto lavorativo attivo" {
}

relation "Rapporto di lavoro passato" {
    attribute "Data inizio";
    attribute "Data fine";
    attribute "Livello";
    attribute "Posizione ricoperta";
}

// Corso
entity Corso {
    attribute "Titolo" key;
    attribute "Edizione" key;
    attribute "Data inizio";
    attribute "Data fine";
    attribute "Numero di partecipanti";

    relation Appartiene (0, N);
    relation Frequenta (0, N);
    relation "Ha frequentato" (0, N);
    relation Insegna (0, N);
    relation Abilitaone (0, N);
}

// Lezione
entity Lezione {
    attribute "Data" key;
    attribute "Ora" key;
    attribute "Durata";

    relation Appartiene (1, 1);
}

// Relazioni corsi
relation Appartiene {
}

relation Frequenta {
}

relation "Ha frequentato" {
    attribute "Giudizio finale";
}

// Insegnante
entity Insegnante total exclusive {
    attribute "Codice fiscale" key;
    attribute "Cognome";
    attribute "Data di nascita"; 
    attribute "Luogo di nascita";
    attribute "Numero di telefono";
    attribute "Indirizzo mail";

    relation Insegna (0, N);
    relation Abilitaone (0, N);
}

// Specializzazioni insegnante
entity "Insegnante interno" specifies Insegnante {
    attribute "Identificatore" key;
    attribute "Data assunzione";
    attribute "Stipendio";
}

entity "Insegnante collaboratore" specifies Insegnante {
    attribute "Identificatore" key;
    attribute "Numero di Partita IVA";
    attribute "Tipo di contratto";
}

// Relazioni insegnamento
relation Insegna {
    attribute "Data inizio";
    attribute "Data fine";
}

relation Abilitaone {
}
